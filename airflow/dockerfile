# Включаем BuildKit для лучшего кеширования
# syntax=docker/dockerfile:1.7

FROM apache/airflow:2.10.4-python3.12

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends openjdk-17-jre-headless curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Копируем модифицированный constraint-файл внутрь образа
COPY constraints-2.10.4.txt /tmp/constraints-2.10.4.txt
COPY requirements.txt /tmp/requirements.txt

# Устанавливаем зависимости с кешированием pip
RUN --mount=type=cache,target=/home/airflow/.cache/pip \
    python3 -m pip install --no-cache-dir \
    --constraint /tmp/constraints-2.10.4.txt \
    -r /tmp/requirements.txt

USER airflow